{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zh Expert OS Expert Envelope",
  "type": "object",
  "required": ["agent_id", "task_id", "status", "confidence", "summary", "claims", "artifacts", "open_questions"],
  "properties": {
    "agent_id": {"type": "string", "minLength": 1},
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Lead-assigned ZEOS assignment id. This is not the WorkBuddy host task_id."
    },
    "status": {"enum": ["ok", "partial", "failed"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "confidence", "evidence"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "evidence-ref.schema.json"}
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relative_path", "sha256"],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "not": {"pattern": "(^/|(^|/)[.][.](/|$))"}
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
